{
  "exe": "./build/strata.exe",
  "args": [
    "--pack",
    "../Strata-data/packs/iq3_s",
    "--native",
    "../Strata-data/models/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
    "--expert-profile",
    "./data/expert-profile.bin",
    "--expert-cache",
    "auto",
    "--prefill",
    "16384",
    "--feed-max",
    "46",
    "--spec",
    "4",
    "--spec-min-p",
    "0.5",
    "--spec-lookup",
    "16",
    "--adapt-every",
    "1",
    "--mtp",
    "../Strata-data/mtp/rt-tuned",
    "--max-context",
    "262144",
    "--kv",
    "k8v4",
    "--kv-grow",
    "--hc-q8",
    "--prompt-shift",
    "0.2",
    "--vision",
    "--pcie-mode",
    "kernel",
    "--pcie-frac",
    "0",
    "--second-gpu",
    "0,1",
    "--second-gpu-reserve-mib",
    "2048,512",
    "--main-gpu",
    "2"
  ],
  "cwd": ".",
  "tokenizer": "../Strata-data/packs/iq3_s/tokenizer",
  "model_name": "qwen3.8-flash-next-iq3_s",
  "port": 8081,
  "sampling": {
    "temperature": 0.7,
    "top_p": 0.95,
    "top_k": 20,
    "min_p": 0.0,
    "presence_penalty": 0.0
  },
  "log": "./strata-iq3_s.log",
  "lib_dirs": [],
  "vision": {
    "exe": "./build-vision/bin/strata-vision.exe",
    "mmproj": "../Strata-data/packs/mmproj-Qwen3.8-Flash-Next-Q8_0.gguf",
    "model": "../Strata-data/models/IQ3_S/Qwen3.8-Flash-Next-GSQ-RCO-IQ3_S-00001-of-00002.gguf",
    "gpu": false,
    "threads": 16,
    "max_tokens": 1024
  },
  "expert_profile_save": "./iq3_s-learned.bin",
  "expert_profile_save_every": 1
}
