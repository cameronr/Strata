# Writes web_assets.cpp: the web app's files (src/server/web) as byte arrays inside lamina-server, so the program needs
# no files beside it. Run by CMake at build time: cmake -DWEB_DIR=<dir> -DOUT=<file> -P embed_web.cmake
file(GLOB_RECURSE _files RELATIVE "${WEB_DIR}" "${WEB_DIR}/*")
list(SORT _files)
set(_body "// generated by cmake/embed_web.cmake from src/server/web: do not edit\n#include \"web_assets.hpp\"\n\nnamespace lamina {\nnamespace {\n")
set(_table "")
set(_i 0)
foreach(_f IN LISTS _files)
  file(READ "${WEB_DIR}/${_f}" _hex HEX)
  string(LENGTH "${_hex}" _n)
  math(EXPR _size "${_n} / 2")
  string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," _bytes "${_hex}")
  string(REGEX REPLACE "((0x[0-9a-f][0-9a-f],){32})" "\\1\n" _bytes "${_bytes}")
  string(APPEND _body "const unsigned char f${_i}[] = {\n${_bytes}0};\n")
  string(APPEND _table "    {\"${_f}\", {reinterpret_cast<const char*>(f${_i}), ${_size}}},\n")
  math(EXPR _i "${_i} + 1")
endforeach()
string(APPEND _body "const WebAsset assets[] = {\n${_table}};\n\n}  // namespace\n\n")
string(APPEND _body "const WebAsset* web_asset(std::string_view name) {\n    for (const auto& a : assets)\n        if (a.name == name) return &a;\n    return nullptr;\n}\n\n}  // namespace lamina\n")
file(WRITE "${OUT}.tmp" "${_body}")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
file(REMOVE "${OUT}.tmp")
